// RUN: check
// COMPILE-FAIL
// EXPECT-EXIT: 65
// CHECK-ERR: was transferred and is no longer valid

// A resource-type variable used after assignment must be rejected.

struct File {
    int fd;

    @destroy { }
}

void main() {
    File a = File { 1 };
    File b = a;
    use(a);  // ERROR: a was transferred to b
}

void use(File f) { }
